{
  "name": "puding",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "validate-server": "node scripts/validate-server.js",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm test && pnpm validate-server",
    "pre-push": "pnpm test && pnpm validate-server"
  },
  "devDependencies": {
    "prettier": "latest",
    "simple-git-hooks": "^2.13.1",
    "turbo": "latest"
  }
}
