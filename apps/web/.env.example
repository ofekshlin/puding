# Backend WebSocket Proxy URL (defaults to ws://localhost:6601 for local development)
# For production deployment, set to wss://<your-backend-domain>
NEXT_PUBLIC_SERVER_WS_URL=ws://localhost:6601

# Google sign-in (Optional; Phase 8). Sign-in turns on only when all four are set;
# otherwise the app keeps the legacy shared access token prompt.
# Auth.js session secret: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth web client; add <origin>/api/auth/callback/google as a redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Shared with the backend's PUDING_AUTH_SECRET; signs the 5-minute Puding tokens.
PUDING_AUTH_SECRET=
