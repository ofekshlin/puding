# Google Gemini API Key (Required for Live API)
GEMINI_API_KEY=your_gemini_api_key_here

# Port for the WebSocket proxy server (Optional, defaults to 6601)
PORT=6601

# Notion Integration Token (Required for Notion Workspace integration)
NOTION_TOKEN=your_notion_integration_token_here

# Tavily API Key (Required for Web Search integration)
TAVILY_API_KEY=your_tavily_api_key_here

# Spotify Media Control (Optional; required only for the Spotify tools)
# Create an app at https://developer.spotify.com/dashboard and add the redirect URI below.
# Obtain the refresh token once via http://localhost:6601/spotify/login
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:6601/spotify/callback
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

