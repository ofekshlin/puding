# Google Gemini API Key (Required for Live API)
GEMINI_API_KEY=your_gemini_api_key_here

# Port for the WebSocket proxy server (Optional, defaults to 6601)
PORT=6601

# Notion Integration Token (Required for Notion Workspace integration)
NOTION_TOKEN=your_notion_integration_token_here

# Tavily API Key (Required for Web Search integration)
TAVILY_API_KEY=your_tavily_api_key_here
# Web searches each user can run per UTC day (the Tavily key is shared)
TAVILY_DAILY_LIMIT_PER_USER=100

# Spotify Media Control (Optional; required only for the Spotify tools)
# Create an app at https://developer.spotify.com/dashboard and add the redirect URI below.
# Obtain the refresh token once via http://localhost:6601/spotify/login
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:6601/spotify/callback
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here


# Puding access token (Required in any deployed environment once Phase 7 lands)
# Clients must connect with ?token=<value>; leave empty for open local development.
PUDING_ACCESS_TOKEN=

# Google sign-in (Optional; Phase 8). The same value as the web app's PUDING_AUTH_SECRET,
# at least 32 bytes (openssl rand -base64 32). Once set, PUDING_ACCESS_TOKEN is ignored and
# clients need a Puding token from the signed-in web app.
PUDING_AUTH_SECRET=
# Comma-separated emails that sign in as approved admins.
ADMIN_EMAILS=
# How new Google accounts get in: allowlist (only ALLOWED_EMAILS), request (default;
# they ask and an admin approves on /admin) or open. Approved users stay approved.
SIGNUP_MODE=request
# Voice sessions (browser tabs) one user may have open at once
MAX_SOCKETS_PER_USER=3
# Comma-separated emails approved on sign-in in allowlist mode.
ALLOWED_EMAILS=
# Comma-separated web app origins allowed to call the REST API (CORS); puding-web
# Vercel previews are always allowed. Defaults to http://localhost:6600.
WEB_ORIGIN=

# Accounts database (Optional; Phase 8). Leave DATABASE_URL empty to run on the env
# credentials above for the implicit local user.
DATABASE_URL=
# Comma-separated version:base64key list; the highest version encrypts. Generate a key
# with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEYS=
# Who may fall back to the env credentials above when DATABASE_URL is set: none | admins | all
ENV_CREDENTIALS_FOR=none

# Devin agent control (Optional; required only for the Devin tools)
# Create a Personal Access Token in Devin settings; org ID has the org- prefix.
DEVIN_API_KEY=your_devin_personal_access_token_here
DEVIN_ORG_ID=your_devin_org_id_here
DEVIN_DEFAULT_REPO=ofekshlin/puding
DEVIN_REPO_ALIASES=puding=ofekshlin/puding
DEVIN_MAX_ACU_PER_SESSION=10
DEVIN_MAX_ACTIVE_SESSIONS=3
DEVIN_POLL_INTERVAL_MS=20000
DEVIN_ENABLE_IN_PREVIEW=false
# Max users whose Devin sessions are polled at once
DEVIN_MAX_WATCHED_USERS=10
